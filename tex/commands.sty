\def\lcm{\rm{lcm}}
\newcommand{\pnorm}[1]{\left| #1 \right|_p}
\newcommand{\ppart}[1]{p^{v_p\left( #1 \right)}}
\newcommand{\maxppart}{\max\left( \ppart{a}, \ppart{b} \right)}
\newcommand{\minppart}{\min\left( \ppart{a}, \ppart{b} \right)}
% \newcommand{\maxppart}{\ppart{\lcm\left( a,b \right)}}
\newcommand{\maxpval}{v_p\left( \lcm\left( a,b \right) \right)}
\newcommand{\minpnorm}{\pnorm{\lcm\left( a,b \right)}}
\newcommand{\diffbnd}{1 - \minpnorm + \maxpval}
\newcommand{\error}{\maxppart - 1}
% \newcommand{\asmptbnd}{\deg L \cdot \maxpval}
\newcommand{\discbnd}{\deg L \cdot \maxpval + \error}
