{
    "name": "LaTeX (TeX Live)",
    "image": "texlive/texlive:TL2023-historic",
    "mounts": [
        {
            "source": "build-${devcontainerId}",
            "target": "${containerWorkspaceFolder}/build",
            "type": "volume"
        }
    ],
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "username": "texlive"
        },
        "ghcr.io/devcontainers/features/git:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "James-Yu.latex-workshop",
                "streetsidesoftware.code-spell-checker",
                "openai.chatgpt",
                "github.vscode-github-actions"
            ]
        }
    },
    "onCreateCommand": "sudo chown -R texlive:texlive build",
    "remoteUser": "texlive"
}